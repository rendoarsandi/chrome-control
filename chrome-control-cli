  --navigate <URL>           Navigate to URL and wait for load
  --click-through            Auto click Next button through course pages
  --solve-survey             Auto solve onboarding survey page-by-page
  --solve-course             Auto solve onboarding courses and quizzes dynamically
  --interactive, -i          Start an interactive control session (REPL)
`);
            process.exit(0);
        }
    }

    let browser;
    try {
        // Connect over CDP
        browser = await chromium.connectOverCDP('http://localhost:9222').catch(async () => {
            await wakeChromeAndForward();
            return await chromium.connectOverCDP('http://localhost:9222');
        });

        const contexts = browser.contexts();
        if (contexts.length === 0) throw new Error("No browser contexts found.");

        const pages = contexts[0].pages();
        if (pages.length === 0) throw new Error("No browser pages found.");

        // Find matching page
        let page = pages[0];
        const keyword = urlKeyword.toLowerCase();
        for (const p of pages) {
            const u = p.url().toLowerCase();
            const t = (await p.title()).toLowerCase();
            if (u.includes(keyword) || t.includes(keyword)) {
                page = p;
                break;
            }
        }

        console.error(`Connected to page: "${await page.title()}"`);

        if (navigateUrl) {
            await page.goto(navigateUrl, { waitUntil: 'load' });
            console.log(`Navigated to ${navigateUrl}`);
        }

        if (getUrl) {
            console.log(page.url());
        }

        if (getTitle) {
            console.log(await page.title());
        }

        if (getText) {
            console.log(await page.innerText('body'));
        }

        if (evalExpr) {
            const result = await page.evaluate(evalExpr);
            if (typeof result === 'object') {
                console.log(JSON.stringify(result, null, 2));
            } else {
                console.log(result);
            }
        }

        if (clickTarget) {
            const isSelector = clickTarget.startsWith('.') || clickTarget.startsWith('#') || clickTarget.startsWith('[') || clickTarget.includes(':');
            const element = isSelector ? page.locator(clickTarget).first() : page.locator(`text=${clickTarget}`).first();
            await element.scrollIntoViewIfNeeded();
            await element.click();
            console.log(`Clicked text/selector: ${clickTarget}`);
        }

        if (clickSelector) {
            const element = page.locator(clickSelector).first();
            await element.scrollIntoViewIfNeeded();
            await element.click();
            console.log(`Clicked selector: ${clickSelector}`);
        }

        if (typeArgs) {
            const [selector, text] = typeArgs;
            const element = page.locator(selector).first();
            await element.scrollIntoViewIfNeeded();
            await element.fill(text);
            console.log(`Filled selector "${selector}" with text`);
        }

        if (clickThrough) {
            await runClickThrough(page);
        }

        if (solveSurveyFlag) {
            await solveSurvey(page);
        }

        if (solveCourseFlag) {
            await solveCourse(page);
        }

        if (interactiveFlag) {
            await runInteractive(page);
        }

        if (screenshotPath) {
            await page.screenshot({ path: screenshotPath });
            console.log(`Screenshot saved to ${screenshotPath}`);
        }

    } catch (err) {
        console.error("CLI Error:", err.message);
        process.exit(1);
    } finally {
        if (browser) {
            await browser.close().catch(() => {});
        }
    }
}

main();
