#!/usr/bin/env node
Object.defineProperty(process, 'platform', { value: 'linux' });
const { chromium } = require('playwright-core');
const { execSync } = require('child_process');

async function wakeChromeAndForward() {
    try {
        console.error('Connection failed. Attempting to wake Chrome and setup adb forward...');
        // Waking Chrome via adb shell monkey
        try {
            const devices = execSync('adb devices').toString().trim().split('\n').slice(1);
            const activeSerials = devices
                .map(line => line.split('\t')[0].trim())
                .filter(serial => serial.length > 0 && !serial.includes('offline'));
                
            if (activeSerials.length > 0) {
                execSync(`adb -s ${activeSerials[0]} shell monkey -p com.android.chrome -c android.intent.category.LAUNCHER 1`);
            } else {
                execSync('adb shell monkey -p com.android.chrome -c android.intent.category.LAUNCHER 1');
            }
        } catch (e) {
            console.error('Warning: Failed to wake Chrome via ADB:', e.message);
        }
        
        // Exposing remote debugging socket
        execSync('adb forward tcp:9222 localabstract:chrome_devtools_remote');
        await new Promise(resolve => setTimeout(resolve, 1500));
    } catch (err) {
        console.error('Error during adb forward:', err.message);
    }
}

async function humanClick(page, locator) {
    try {
        await locator.scrollIntoViewIfNeeded();
        await new Promise(r => setTimeout(r, 200 + Math.random() * 200));
        await locator.hover();
        await new Promise(r => setTimeout(r, 100 + Math.random() * 100));
        await locator.click({ timeout: 5000 });
        console.log("Successfully clicked using standard Playwright click.");
    } catch (e) {
        console.error("Standard click failed, attempting bounding box click...", e.message);
        try {
            const box = await locator.boundingBox();
            if (box) {
                await page.mouse.move(box.x + box.width / 2, box.y + box.height / 2, { steps: 5 });
                await new Promise(r => setTimeout(r, 100));
                await page.mouse.click(box.x + box.width / 2, box.y + box.height / 2);
                console.log("Successfully clicked using mouse bounding box.");
                return;
            }
        } catch (err) {
            console.error("Bounding box click failed, falling back to page.evaluate click...", err.message);
        }
        // Last fallback
        await locator.evaluate(el => el.click());
        console.log("Successfully clicked using DOM element.click().");
    }
}

async function humanType(page, locator, text) {
    await locator.scrollIntoViewIfNeeded();
    await locator.focus();
    // Clear existing text if any
    await locator.fill('');
    await new Promise(r => setTimeout(r, 150));
    // Type character by character
    for (const char of text) {
        await page.keyboard.type(char, { delay: 30 + Math.random() * 50 });
    }
    await new Promise(r => setTimeout(r, 200));
}

async function runClickThrough(page) {
    while (true) {
        const url = page.url();
        const title = await page.title();
        console.log(`URL: ${url} | Title: ${title}`);

        const nextBtn = page.locator([
            'input[value="Next"]',
            'button:has-text("Next")',
            'input[type="submit"][value="Next"]',
            'a:has-text("Next")',
            '.btn-primary:has-text("Next")',
            '.next-button:visible'
        ].join(', ')).first();

        if (await nextBtn.isVisible()) {
            console.log("Clicking 'Next' with human interaction...");
            await humanClick(page, nextBtn);
            await page.waitForLoadState('load');
            await new Promise(r => setTimeout(r, 2000));
        } else {
            console.log("No 'Next' button found. Click-through completed.");
            break;
        }
    }
}

async function solveSurvey(page) {
    const surveyAnswers = [
        { keys: ["motivation", "why did you decide", "why did you choose"], type: "choice", value: "I would like to develop a new skill." },
        { keys: ["progress", "how satisfied are you", "your progress"], type: "choice", value: "Neutral" },
        { keys: ["easy for you to understand how to start the onboarding", "start the onboarding process", "easy to understand how to start"], type: "choice", value: "Yes" },
        { keys: ["exploratory testing course content easy to understand", "exploratory course content", "content easy to understand"], type: "choice", value: "Yes" },
        { keys: ["most difficult for you in the exploratory testing course", "most difficult", "what was most difficult"], type: "choice", value: "Everything was straight-forward" },
        { keys: ["exploratory testing course feedback", "share more feedback on the exploratory testing course", "feedback on the exploratory testing course", "exploratory testing course here"], type: "text", value: "The course content is very comprehensive, structured, and easy to follow. No issues encountered." },
        { keys: ["onboarding improvement ideas", "suggestions to improve the onboarding", "improve the onboarding", "onboarding here", "ideas to improve"], type: "text", value: "The onboarding process is very smooth. Having interactive quizzes and practical tasks is highly effective. Maybe add more real-world examples of visual vs functional bugs to help newer testers even more." },
        { keys: ["expectations from test io", "expect from test io", "what do you expect", "expectations here"], type: "text", value: "I expect to participate in diverse testing cycles, improve my testing capabilities across different platforms and environments, gain practical experience, and receive fair compensation for identifying high-quality bugs." }
    ];

    console.log("Starting Survey Solver...");
    
    // Welcome/Start screen
    const startBtn = page.locator('button:has-text("Start"), a:has-text("Start"), button[data-qa*="start-button"]').first();
    if (await startBtn.isVisible()) {
        console.log("Start screen detected. Clicking Start...");
        await humanClick(page, startBtn);
        await new Promise(r => setTimeout(r, 2000));
    }

    for (let step = 1; step <= 20; step++) {
        // Find visible active block
        const activeBlock = page.locator('[data-qa*="blocktype-"]:visible, [class*="active"] [data-qa*="blocktype-"]').first();
        let blockText = "";
        if (await activeBlock.isVisible()) {
            blockText = await activeBlock.innerText();
        } else {
            // Check body text fallback
            blockText = await page.innerText('body');
        }

        console.log(`\n================ STEP ${step} ================`);
        console.log("Active Block Text Snippet:", blockText.replace(/\n/g, ' ').substring(0, 150).trim());

        const lowerText = blockText.toLowerCase();

        // Check if finished or submit screen
        if (lowerText.includes("submit") || lowerText.includes("finish") || lowerText.includes("completed") || lowerText.includes("thank you")) {
            const submitBtn = page.locator('button[data-qa*="submit-button"]:visible, button[data-qa*="ok-button-visible"]:has-text("Submit"), button[data-qa*="ok-button-visible"]:has-text("Finish")').first();
            if (await submitBtn.isVisible()) {
                console.log("Submit/Finish button detected. Submitting survey...");
                await humanClick(page, submitBtn);
                await new Promise(r => setTimeout(r, 5000));
                break;
            }
        }

        // Check matching questions
        let matched = false;
        for (const answer of surveyAnswers) {
            const isMatch = answer.keys.some(key => lowerText.includes(key.toLowerCase()));
            if (isMatch) {
                matched = true;
                if (answer.type === "choice") {
                    console.log(`Matching Choice Question found. Selecting Option: "${answer.value}"`);
                    const choice = page.locator([
                        `[data-qa*="choice"]:has-text("${answer.value}")`,
                        `[role="radio"]:has-text("${answer.value}")`,
                        `[role="checkbox"]:has-text("${answer.value}")`,
                        `button:visible:has-text("${answer.value}")`,
                        `div:visible:has-text("${answer.value}")`
                    ].join(', ')).last();
                    
                    await humanClick(page, choice);
                    await new Promise(r => setTimeout(r, 500));
                } else if (answer.type === "text") {
                    console.log(`Matching Text Input Question found. Entering response.`);
                    const input = page.locator('textarea:visible, input[type="text"]:visible, [role="textbox"]:visible').first();
                    await humanType(page, input, answer.value);
                    await new Promise(r => setTimeout(r, 500));
                }

                // Click OK button
                const okBtn = page.locator([
                    'button[data-qa*="ok-button-visible"]:visible',
                    'button[data-qa*="submit-button"]:visible',
                    'button:visible:has-text("OK")',
                    'button:visible:has-text("Continue")',
                    'button:visible:has-text("Submit")',
                    '[role="button"]:visible:has-text("OK")',
                    '[role="button"]:visible:has-text("Continue")'
                ].join(', ')).first();

                if (await okBtn.isVisible()) {
                    console.log("Clicking OK/Continue...");
                    await humanClick(page, okBtn);
                    await new Promise(r => setTimeout(r, 2500));
                } else {
                    console.log("OK/Continue button not visible, maybe auto-advanced!");
                }
                break;
            }
        }

        if (!matched) {
            // Try to click continue if visible
            const contBtn = page.locator([
                'button[data-qa*="ok-button-visible"]:visible:has-text("Continue")',
                'button[data-qa*="ok-button-visible"]:visible:has-text("OK")',
                'button:visible:has-text("OK")',
                'button:visible:has-text("Continue")'
            ].join(', ')).first();

            if (await contBtn.isVisible()) {
                console.log("No specific question matched, but Continue/OK button is visible. Clicking it...");
                await humanClick(page, contBtn);
                await new Promise(r => setTimeout(r, 2500));
            } else {
                console.log("No matched questions or Continue/OK button found. Survey might be finished!");
                break;
            }
        }
    }

    console.log("\nSurvey Finished!");
    console.log("Current page title:", await page.title());
}

async function solveCourse(page) {
    console.log("Starting Dynamic Course Solver...");
    
    // Load quiz answers dynamically
    let qaDatabase = [];
    try {
        const fs = require('fs');
        const path = require('path');
        const dbPath = path.join(__dirname, 'quiz_answers.json');
        if (fs.existsSync(dbPath)) {
            qaDatabase = JSON.parse(fs.readFileSync(dbPath, 'utf8'));
            console.log(`Successfully loaded ${qaDatabase.length} QA patterns from quiz_answers.json.`);
        }
    } catch (e) {
        console.error("Warning: Failed to load quiz_answers.json:", e.message);
    }

    const maxSteps = 100;
    let lastUrl = '';
    let sameUrlCount = 0;

    for (let step = 1; step <= maxSteps; step++) {
        const currentUrl = page.url();
        console.log(`\n================ STEP ${step} | URL: ${currentUrl} ================`);

        // Detect infinite loop on same URL
        if (currentUrl === lastUrl) {
            sameUrlCount++;
            if (sameUrlCount > 8) {
                console.log("Detected stuck state (same URL for 8 steps). Exiting...");
                break;
            }
        } else {
            lastUrl = currentUrl;
            sameUrlCount = 0;
        }

        // Wait a small moment for page to stabilize
        await new Promise(r => setTimeout(r, 2000));

        // Get visible text on the page to identify the question/state
        const bodyText = await page.innerText('body');
        const lowerText = bodyText.toLowerCase();

        // 1. Check if we are on a Finish/Success/Thank You page
        if (lowerText.includes("thank you") || lowerText.includes("congratulations") || lowerText.includes("successfully completed") || lowerText.includes("feedback and suggestions")) {
            console.log("Course completed screen detected!");
            const finishBtn = page.locator('button:visible:has-text("Finish"), button:visible:has-text("Submit"), button:visible:has-text("Back to dashboard")').first();
            if (await finishBtn.isVisible()) {
                console.log("Clicking final finish/submit button...");
                await humanClick(page, finishBtn);
                await new Promise(r => setTimeout(r, 3000));
            }
            break;
        }

        // 2. Check if we have standard course transition buttons
        const startBtn = page.locator('button:visible:has-text("Go to quiz"), button:visible:has-text("Start quiz"), button:visible:has-text("Start"), button:visible:has-text("Got it")').first();
        if (await startBtn.isVisible()) {
            console.log("Transition button found. Clicking...");
            await humanClick(page, startBtn);
            continue;
        }

        // 3. Check if there are form questions or quiz questions on the page
        const hasInputs = await page.locator('input[type="radio"]:visible, input[type="checkbox"]:visible, textarea:visible, input[type="text"]:visible, .option-item:visible, [role="radio"]:visible, [role="checkbox"]:visible').count() > 0;
        
        if (hasInputs) {
            console.log("Inputs detected. Analyzing question...");
            
            let questionText = "";
            const headers = page.locator('h1:visible, h2:visible, h3:visible, h4:visible, legend:visible, .question-title:visible, .question:visible');
            const hCount = await headers.count();
            for (let i = 0; i < hCount; i++) {
                const text = (await headers.nth(i).innerText()).trim();
                const textLower = text.toLowerCase();
                // Exclude generic course header titles
                if (textLower.includes("course") && (textLower.includes("reproduction") || textLower.includes("exploratory") || textLower.includes("cybersecurity") || textLower.includes("academy"))) {
                    continue;
                }
                if (text.length > 5) {
                    questionText = text;
                    break;
                }
            }

            if (!questionText) {
                const firstOptText = await page.locator('input[type="radio"]:visible, input[type="checkbox"]:visible, textarea:visible, input[type="text"]:visible, [role="radio"]:visible, [role="checkbox"]:visible').first().innerText().catch(() => '');
                const endIdx = lowerText.indexOf(firstOptText.toLowerCase());
                if (endIdx > 0) {
                    questionText = bodyText.substring(0, endIdx).trim();
                } else {
                    questionText = bodyText.substring(0, 300).trim();
                }
            }

            console.log(`Detected Question Text: "${questionText.replace(/\n/g, ' ')}"`);

            let matchedAnswer = null;
            const lowerQuestion = questionText.toLowerCase();
            for (const item of qaDatabase) {
                const isMatch = item.keys.some(key => lowerQuestion.includes(key.toLowerCase()));
                if (isMatch) {
                    matchedAnswer = item;
                    break;
                }
            }

            if (matchedAnswer) {
                console.log("Match found in quiz_answers.json!");
                if (matchedAnswer.type === "choice") {
                    console.log("Solving choice question...");
                    for (const ansVal of matchedAnswer.answers) {
                        console.log(`Locating option matching: "${ansVal}"`);
                        const choiceOpt = page.locator([
                            `input[type="radio"] >> xpath=ancestor::label[contains(., "${ansVal}")]`,
                            `input[type="checkbox"] >> xpath=ancestor::label[contains(., "${ansVal}")]`,
                            `[role="radio"]:has-text("${ansVal}")`,
                            `[role="checkbox"]:has-text("${ansVal}")`,
                            `[data-qa*="choice"]:has-text("${ansVal}")`,
                            `label:visible:has-text("${ansVal}")`,
                            `div:visible:has-text("${ansVal}")`
                        ].join(', ')).last();

                        if (await choiceOpt.isVisible()) {
                            await humanClick(page, choiceOpt);
                            await new Promise(r => setTimeout(r, 400));
                        } else {
                            console.error(`Could not locate choice option matching: "${ansVal}"`);
                        }
                    }
                } else if (matchedAnswer.type === "text") {
                    console.log("Solving text question...");
                    const textInput = page.locator('textarea:visible, input[type="text"]:visible, [role="textbox"]:visible').first();
                    if (await textInput.isVisible()) {
                        await humanType(page, textInput, matchedAnswer.answers[0]);
                        await new Promise(r => setTimeout(r, 400));
                    }
                }

                const nextBtn = page.locator([
                    'button[data-qa*="ok-button-visible"]:visible',
                    'button[data-qa*="submit-button"]:visible',
                    'button:visible:has-text("OK")',
                    'button:visible:has-text("Continue")',
                    'button:visible:has-text("Submit")',
                    'button:visible:has-text("Next")',
                    '[role="button"]:visible:has-text("OK")',
                    '[role="button"]:visible:has-text("Continue")',
                    '[role="button"]:visible:has-text("Next")'
                ].join(', ')).first();

                if (await nextBtn.isVisible()) {
                    console.log("Clicking Next/Continue...");
                    await humanClick(page, nextBtn);
                    await new Promise(r => setTimeout(r, 2000));
                }
            } else {
                console.log(`\n[Co-Pilot Mode] Unknown Question: "${questionText.replace(/\n/g, ' ')}"`);
                console.log("--------------------------------------------------");
                console.log("Please tap your choice(s) on the phone's Chrome screen.");
                console.log("The co-pilot will automatically resume once the page advances or the next button is clicked!");
                console.log("--------------------------------------------------");
                
                let advanced = false;
                for (let waitSec = 0; waitSec < 60; waitSec++) {
                    await new Promise(r => setTimeout(r, 2000));
                    const newUrl = page.url();
                    const newBody = await page.innerText('body');
                    if (newUrl !== currentUrl || newBody !== bodyText) {
                        console.log("Detected change! Resuming co-pilot loop...");
                        advanced = true;
                        break;
                    }
                }
                if (!advanced) {
                    console.log("No interaction detected after 120 seconds. Pausing co-pilot.");
                    break;
                }
            }
        } else {
            const nextBtn = page.locator([
                'input[value="Next"]',
                'button:has-text("Next")',
                'input[type="submit"][value="Next"]',
                'a:has-text("Next")',
                '.btn-primary:has-text("Next")',
                '.next-button:visible',
                'button:visible:has-text("Continue")',
                'a:visible:has-text("Continue")'
            ].join(', ')).first();

            if (await nextBtn.isVisible()) {
                console.log("Standard reading page. Clicking Next/Continue...");
                await humanClick(page, nextBtn);
                await page.waitForLoadState('load');
                await new Promise(r => setTimeout(r, 2000));
            } else {
                console.log("No interactive elements or Next buttons found. Course might be complete!");
                break;
            }
        }
    }
}

async function runInteractive(page) {
    const readline = require('readline');
    console.log("Entering Chrome Control Interactive REPL.");
    console.log("Type 'help' for a list of commands, or 'exit' / 'quit' to quit.");
    
    const rl = readline.createInterface({
        input: process.stdin,
        output: process.stdout,
        prompt: 'chrome-control> '
    });
    
    let activeCount = 0;
    let isClosed = false;
    
    rl.prompt();
    
    rl.on('line', async (line) => {
        const trimmed = line.trim();
        if (!trimmed) {
            rl.prompt();
            return;
        }
        
        if (trimmed === 'exit' || trimmed === 'quit') {
            rl.close();
            return;
        }
        
        activeCount++;
        rl.pause();
        const spaceIdx = trimmed.indexOf(' ');
        const cmd = spaceIdx === -1 ? trimmed : trimmed.substring(0, spaceIdx);
        const argsStr = spaceIdx === -1 ? '' : trimmed.substring(spaceIdx + 1).trim();
        
        try {
            if (cmd === 'help') {
                console.log(`
Available commands:
  url / get-url                  Print current URL
  title / get-title              Print current Title
  text / get-text                Print visible text on page
  click <target>                 Click element by text or selector
  click-selector <selector>      Click element by CSS selector
  type <selector> <text>         Type text into input matching selector
  screenshot <path>              Save page screenshot to path
  navigate <url>                 Navigate to URL
  eval <js_code>                 Evaluate JavaScript on the page
  click-through                  Start auto-click-through for course pages
  solve-survey                   Start onboarding survey solver
  solve-course                   Start dynamic onboarding course/quiz solver
  exit / quit                    Quit the interactive session
`);
            } else if (cmd === 'url' || cmd === 'get-url') {
                console.log(page.url());
            } else if (cmd === 'title' || cmd === 'get-title') {
                console.log(await page.title());
            } else if (cmd === 'text' || cmd === 'get-text') {
                console.log(await page.innerText('body'));
            } else if (cmd === 'click') {
                const target = argsStr;
                if (!target) {
                    console.log("Error: click command requires a target (text or selector)");
                } else {
                    const isSelector = target.startsWith('.') || target.startsWith('#') || target.startsWith('[') || target.includes(':');
                    const element = isSelector ? page.locator(target).first() : page.locator(`text=${target}`).first();
                    await element.scrollIntoViewIfNeeded();
                    await humanClick(page, element);
                    console.log(`Clicked target: ${target}`);
                }
            } else if (cmd === 'click-selector') {
                const selector = argsStr;
                if (!selector) {
                    console.log("Error: click-selector command requires a CSS selector");
                } else {
                    const element = page.locator(selector).first();
                    await element.scrollIntoViewIfNeeded();
                    await humanClick(page, element);
                    console.log(`Clicked selector: ${selector}`);
                }
            } else if (cmd === 'type') {
                const match = argsStr.match(/^(\S+)\s+(.+)$/);
                if (!match) {
                    console.log("Error: type command requires <selector> and <text>");
                } else {
                    const selector = match[1];
                    const text = match[2];
                    const element = page.locator(selector).first();
                    await element.scrollIntoViewIfNeeded();
                    await humanType(page, element, text);
                    console.log(`Typed into selector "${selector}"`);
                }
            } else if (cmd === 'screenshot') {
                const path = argsStr || 'screenshot_current.png';
                await page.screenshot({ path });
                console.log(`Screenshot saved to ${path}`);
            } else if (cmd === 'navigate') {
                const url = argsStr;
                if (!url) {
                    console.log("Error: navigate command requires a URL");
                } else {
                    await page.goto(url, { waitUntil: 'load' });
                    console.log(`Navigated to ${url}`);
                }
            } else if (cmd === 'eval') {
                const expr = argsStr;
                if (!expr) {
                    console.log("Error: eval command requires a JavaScript expression");
                } else {
                    const result = await page.evaluate(expr);
                    if (typeof result === 'object') {
                        console.log(JSON.stringify(result, null, 2));
                    } else {
                        console.log(result);
                    }
                }
            } else if (cmd === 'click-through') {
                await runClickThrough(page);
            } else if (cmd === 'solve-survey') {
                await solveSurvey(page);
            } else if (cmd === 'solve-course') {
                await solveCourse(page);
            } else {
                console.log(`Unknown command: ${cmd}. Type 'help' for a list of commands.`);
            }
        } catch (err) {
            console.log(`Command Error: ${err.message}`);
        } finally {
            activeCount--;
            if (!isClosed) {
                rl.resume();
                rl.prompt();
            } else if (activeCount === 0) {
                process.exit(0);
            }
        }
    });
    
    rl.on('close', () => {
        isClosed = true;
        if (activeCount === 0) {
            process.exit(0);
        }
    });
    
    await new Promise(() => {});
}

async function main() {
    // 1. Parsing Arguments
    const args = process.argv.slice(2);
    
    let urlKeyword = 'testio';
    let getUrl = false;
    let getTitle = false;
    let getText = false;
    let evalExpr = null;
    let clickTarget = null;
    let clickSelector = null;
    let typeArgs = null;
    let screenshotPath = null;
    let navigateUrl = null;
    let clickThrough = false;
    let solveSurveyFlag = false;
    let solveCourseFlag = false;
    let interactiveFlag = false;

    for (let i = 0; i < args.length; i++) {
        if (args[i] === '--url-keyword') {
            urlKeyword = args[++i];
        } else if (args[i] === '--get-url') {
            getUrl = true;
        } else if (args[i] === '--get-title') {
            getTitle = true;
        } else if (args[i] === '--get-text') {
            getText = true;
        } else if (args[i] === '--eval') {
            evalExpr = args[++i];
        } else if (args[i] === '--click') {
            clickTarget = args[++i];
        } else if (args[i] === '--click-selector') {
            clickSelector = args[++i];
        } else if (args[i] === '--type') {
            typeArgs = [args[++i], args[++i]];
        } else if (args[i] === '--screenshot') {
            screenshotPath = args[++i];
        } else if (args[i] === '--navigate') {
            navigateUrl = args[++i];
        } else if (args[i] === '--click-through') {
            clickThrough = true;
        } else if (args[i] === '--solve-survey') {
            solveSurveyFlag = true;
        } else if (args[i] === '--solve-course') {
            solveCourseFlag = true;
        } else if (args[i] === '--interactive' || args[i] === '-i') {
            interactiveFlag = true;
        } else if (args[i] === '--help' || args[i] === '-h') {
            console.log(`
Playwright-Core Android Chrome CLI

Options:
  --url-keyword <KEYWORD>    Keyword to match tab URL or Title (default: 'testio')
  --get-url                  Print active tab URL
  --get-title                Print active tab Title
  --get-text                 Print active page body text
  --eval <JS_EXPR>           Evaluate JavaScript expression on page
  --click <TARGET>           Click element by text or selector
  --click-selector <SELECT>  Click element by CSS selector
